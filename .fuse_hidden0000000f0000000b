<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lesson 11 – Interviewing Others</title>
<style>

:root {
  --navy:#1a2e4a; --blue:#2563eb; --lb:#dbeafe;
  --teal:#0d9488; --lt:#ccfbf1;
  --amber:#d97706; --la:#fef3c7;
  --rose:#e11d48; --lr:#ffe4e6; --orange:#ea580c; --lo:#ffedd5;
  --purple:#7c3aed; --lp:#ede9fe;
  --indigo:#4338ca; --li:#e0e7ff;
  --green:#16a34a; --lg:#dcfce7;
  --gray:#6b7280; --lgr:#f3f4f6;
  --border:#e5e7eb; --text:#111827; --textl:#6b7280;
}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Segoe UI',Arial,sans-serif;background:#f1f5f9;color:var(--text);font-size:15px;line-height:1.6;zoom:1.4;}

/* ── TOP HOME STRIP ── */
  .top-home-strip {
    position: fixed; top: 0; left: 0; right: 0; z-index: 400;
    background: var(--navy); height: 42px;
    display: flex; align-items: center; justify-content: flex-start;
    padding: 0 20px; box-shadow: 0 2px 6px rgba(0,0,0,0.25);
  }
  .top-home-link {
    color: white; text-decoration: none; font-size: 13px; font-weight: 700;
    font-family: inherit; display: flex; align-items: center; gap: 6px;
    opacity: .85; transition: opacity .15s;
  }
  .top-home-link:hover { opacity: 1; }
  body { padding-top: 42px; }

#notesBtn{position:fixed;top:14px;right:22px;z-index:1000;background:rgba(26,46,74,.88);color:#fff;border:none;padding:9px 20px;border-radius:22px;cursor:pointer;font-size:.92rem;font-weight:600;letter-spacing:.02em;transition:background .2s;backdrop-filter:blur(4px);}
#notesBtn:hover{background:rgba(26,46,74,1);}
#notesBtn.panel-open{background:#0d5986;}
#pdfBtn{position:fixed;top:14px;right:140px;z-index:1000;background:rgba(26,46,74,.88);color:#fff;border:none;padding:9px 20px;border-radius:22px;cursor:pointer;font-size:.92rem;font-weight:600;letter-spacing:.02em;transition:background .2s;backdrop-filter:blur(4px);}
#pdfBtn:hover{background:rgba(26,46,74,1);}

/* ── NOTES PANEL ── */
#notesPanel{
  position:fixed;top:54px;right:22px;z-index:999;
  width:360px;max-height:0;overflow:hidden;
  background:rgba(26,46,74,.92);border-radius:14px;
  box-shadow:0 8px 32px rgba(0,0,0,.35);
  display:flex;flex-direction:column;gap:0;
  border:none;backdrop-filter:blur(6px);
  opacity:0;transition:opacity .25s ease;
}
#notesPanel.open{display:flex;max-height:420px;opacity:1;overflow:visible;}
.notes-drag-handle{
  cursor:move;display:flex;align-items:center;gap:6px;
  margin:0;padding:8px 12px;
  border-radius:14px 14px 0 0;background:rgba(26,46,74,.85);
  border-bottom:1px solid rgba(255,255,255,.15);
  font-size:11px;font-weight:800;color:rgba(255,255,255,.55);letter-spacing:.6px;
  user-select:none;touch-action:none;
}
.notes-drag-handle .grip{font-size:13px;letter-spacing:1px;color:rgba(255,255,255,.35);}
.notes-toolbar{display:flex;gap:6px;align-items:center;padding:6px 10px;background:rgba(26,46,74,.7);}
.notes-toolbar-label{font-size:10px;font-weight:700;color:rgba(255,255,255,.5);letter-spacing:.5px;margin-right:2px;}
.notes-tbtn{
  background:rgba(255,255,255,.12);border:none;border-radius:5px;
  padding:3px 9px;cursor:pointer;font-size:.85rem;font-weight:700;
  transition:background .15s;color:#fff;font-family:inherit;
}
.notes-tbtn:hover{background:rgba(255,255,255,.25);}
#notesTA{
  min-height:220px;max-height:260px;overflow-y:auto;
  border:none;border-radius:0;padding:14px;
  font-size:.8rem;line-height:1.5;outline:none;
  font-family:'Segoe UI',Arial,sans-serif;color:#fff;
  background:rgba(26,46,74,.92);
}
#notesTA:empty:before{content:attr(placeholder);color:rgba(255,255,255,.4);pointer-events:none;}
#notesTA:focus{border-color:transparent;}
#notesTA [style*="background-color"]{color:#1a1a1a!important;}
.notes-actions{display:flex;gap:8px;justify-content:space-between;align-items:center;padding:8px 10px;border-top:1px solid rgba(255,255,255,.12);}
.notes-clear-btn{
  background:rgba(255,90,90,.18);border:none;border-radius:8px;
  padding:5px 11px;font-size:11px;color:#fff;cursor:pointer;transition:background .2s;font-family:inherit;
}
.notes-clear-btn:hover{background:rgba(255,90,90,.35);}
.slide-notes-print{display:none;}

/* ── PRINT ── */
@media print{
  *{-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important;}
  .top-home-strip,#notesPanel,#notesBtn,#pdfBtn{display:none!important;}
  html,body{zoom:1!important;padding-top:0!important;}
}

/* ── SLIDE NAVBAR ── */
.slide-navbar {
  background: white; border-bottom: 2px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 22px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); gap: 12px;
}
.slide-nav-btn {
  background: var(--navy); color: white; border: none; border-radius: 8px;
  padding: 8px 20px; font-size: 13px; font-weight: 700; cursor: pointer;
  font-family: inherit; transition: background .15s; white-space: nowrap;
}
.slide-nav-btn:hover:not(:disabled) { background: #263d5c; }
.slide-nav-btn:disabled { opacity: .3; cursor: default; }
.slide-info { text-align: center; flex: 1; }
.slide-label { font-weight: 700; color: var(--navy); font-size: 14px; }
.slide-counter-text { font-size: 12px; color: var(--gray); margin: 2px 0 6px; }
.slide-progress { display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; }
.sp-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--border); cursor: pointer; transition: all .15s; }
.sp-dot.active { background: var(--navy); transform: scale(1.3); }
.sp-dot.done { background: var(--teal); }

/* ── SLIDES ── */
.slide { display: none; }
.slide.active { display: block; animation: fadeIn .2s ease; }
@keyframes fadeIn { from{opacity:0;transform:translateY(6px);} to{opacity:1;transform:translateY(0);} }

/* ── COVER SLIDE ── */
.cover-slide {
  min-height: calc(100vh - 98px);
  background: linear-gradient(140deg, var(--navy) 0%, #1e3a5f 60%, #0d5986 100%);
  display: flex; align-items: center; justify-content: center;
  padding: 40px 20px; position: relative; overflow: hidden;
}
.cover-slide::before {
  content:''; position:absolute; top:-80px; right:-80px;
  width:320px; height:320px; border-radius:50%;
  background:rgba(255,255,255,0.04);
}
.cover-slide::after {
  content:''; position:absolute; bottom:-60px; left:-60px;
  width:240px; height:240px; border-radius:50%;
  background:rgba(255,255,255,0.03);
}
.cover-inner {
  text-align: center; color: white; position: relative; z-index: 1;
}
.cover-label {
  font-size: 10.5px; letter-spacing: 3px; text-transform: uppercase;
  color: rgba(255,255,255,0.5); margin-bottom: 10px;
}
.cover-module {
  display: inline-block; background: rgba(255,255,255,0.12);
  border-radius: 20px; padding: 5px 20px; font-size: 12px;
  font-weight: 700; letter-spacing: .5px; margin-bottom: 28px; color: rgba(255,255,255,0.85);
}
.cover-title {
  font-size: 48px; font-weight: 900; line-height: 1.05;
  margin-bottom: 14px; letter-spacing: -.5px;
}
.cover-title .accent { color: #8b5cf6; }
.cover-badge {
  display: inline-block; background: var(--teal); color: white;
  border-radius: 20px; padding: 6px 22px; font-size: 13px;
  font-weight: 700; margin-top: 8px;
}

/* ── MAIN CARD ── */
.main { max-width: 920px; margin: 0 auto; padding: 28px 18px 80px; }
.card { background:white; border-radius:16px; border:1px solid var(--border); margin-bottom:26px; overflow:hidden; box-shadow:0 1px 4px rgba(0,0,0,0.06); }
.card-head { display:flex; align-items:center; gap:14px; padding:15px 22px; border-bottom:1px solid var(--border); }
.card-icon { width:38px; height:38px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
.card-label { font-size:10px; letter-spacing:1.5px; text-transform:uppercase; color:var(--gray); margin-bottom:2px; }
.card-title { font-size:16px; font-weight:700; }
.card-badge { margin-left:auto; font-size:11px; font-weight:700; color:white; border-radius:12px; padding:3px 11px; white-space:nowrap; }
.card-body { padding:22px; }
.c-teal .card-head{background:var(--lt);} .c-teal .card-icon{background:var(--teal);color:white;} .c-teal .card-title{color:var(--teal);} .c-teal .card-badge{background:var(--teal);}
.c-indigo .card-head{background:var(--li);} .c-indigo .card-icon{background:var(--indigo);color:white;} .c-indigo .card-title{color:var(--indigo);} .c-indigo .card-badge{background:var(--indigo);}
.c-blue .card-head{background:var(--lb);} .c-blue .card-icon{background:var(--blue);color:white;} .c-blue .card-title{color:var(--blue);} .c-blue .card-badge{background:var(--blue);}
.c-purple .card-head{background:var(--lp);} .c-purple .card-icon{background:var(--purple);color:white;} .c-purple .card-title{color:var(--purple);} .c-purple .card-badge{background:var(--purple);}
.c-amber .card-head{background:var(--la);} .c-amber .card-icon{background:var(--amber);color:white;} .c-amber .card-title{color:var(--amber);} .c-amber .card-badge{background:var(--amber);}
.c-navy .card-head{background:#eef0f3;} .c-navy .card-icon{background:var(--navy);color:white;} .c-navy .card-title{color:var(--navy);} .c-navy .card-badge{background:var(--navy);}
.c-green .card-head{background:var(--lg);} .c-green .card-icon{background:var(--green);color:white;} .c-green .card-title{color:var(--green);} .c-green .card-badge{background:var(--green);}
.c-orange .card-head{background:var(--lo);} .c-orange .card-icon{background:var(--orange);color:white;} .c-orange .card-title{color:var(--orange);} .c-orange .card-badge{background:var(--orange);}

/* ── ACT HEAD ── */
.act-head{display:flex;align-items:center;gap:10px;padding:9px 14px;background:var(--lgr);border-radius:8px;margin-bottom:14px;font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--gray);}
.act-num{background:var(--navy);color:white;min-width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;flex-shrink:0;}
.divider{height:1px;background:var(--border);margin:20px 0;}

/* ── TFD ── */
.tfd-item{display:flex;align-items:flex-start;gap:14px;padding:14px;border:1.5px solid var(--border);border-radius:10px;margin-bottom:10px;background:#fafafa;}
.tfd-num{font-weight:700;color:var(--gray);font-size:13px;min-width:20px;margin-top:2px;}
.tfd-text{flex:1;font-size:14px;line-height:1.5;}
.tfd-btns{display:flex;gap:6px;flex-shrink:0;flex-wrap:wrap;}
.tfd-btn{border:1.5px solid var(--border);background:white;border-radius:8px;padding:5px 12px;font-size:12px;font-weight:700;cursor:pointer;transition:all .15s;font-family:inherit;color:var(--text);}
.tfd-btn:hover:not(.locked){border-color:var(--navy);color:var(--navy);}
.tfd-btn.sel-t{background:#dcfce7;border-color:var(--green);color:#14532d;}
.tfd-btn.sel-f{background:#ffe4e6;border-color:var(--rose);color:#9f1239;}
.tfd-btn.sel-d{background:var(--la);border-color:var(--amber);color:#92400e;}
.tfd-btn.locked{opacity:.6;cursor:default;}
.tfd-exp{display:none;margin-top:10px;padding:9px 13px;border-radius:8px;font-size:13px;background:var(--lg);border:1px solid #86efac;color:#14532d;line-height:1.5;}
.tfd-exp.show{display:block;}

/* ── READING ── */
.reading-passage{background:#fafafa;border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:20px;font-size:14px;line-height:1.75;}
.reading-passage h3{font-size:16px;font-weight:700;color:var(--indigo);margin-bottom:10px;}
.reading-passage p{margin-bottom:10px;}
.mc-item{margin-bottom:16px;}
.mc-q{font-size:14px;font-weight:600;margin-bottom:8px;color:var(--text);}
.mc-opts{display:flex;flex-direction:column;gap:6px;}
.mc-opt{padding:9px 14px;border:1.5px solid var(--border);border-radius:8px;font-size:13.5px;cursor:pointer;background:white;transition:all .15s;font-family:inherit;text-align:left;}
.mc-opt:hover:not(.locked){border-color:var(--indigo);background:var(--li);}
.mc-opt.correct{background:#dcfce7!important;border-color:var(--green)!important;color:#14532d!important;}
.mc-opt.wrong{background:#ffe4e6!important;border-color:var(--rose)!important;color:#9f1239!important;}
.mc-opt.locked{cursor:default;}

/* ── VOCAB CARDS ── */
.vocab-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px;margin-bottom:20px;}
.vocab-card{border:1.5px solid var(--border);border-radius:12px;padding:14px 16px;background:white;}
.vocab-card .vc-term{font-size:15px;font-weight:800;color:var(--blue);margin-bottom:4px;}
.vocab-card .vc-def{font-size:13px;color:var(--gray);margin-bottom:6px;font-style:italic;}
.vocab-card .vc-ex{font-size:13px;color:var(--text);line-height:1.5;}
.vocab-card .vc-ex em{font-style:italic;color:var(--blue);}

/* ── WORD BANK ── */
.wb-bank{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;padding:14px;background:var(--lb);border-radius:10px;}
.wb-word{padding:6px 14px;background:white;border:1.5px solid var(--blue);border-radius:20px;font-size:13px;font-weight:700;color:#1e40af;cursor:pointer;transition:all .15s;user-select:none;}
.wb-word:hover:not(.used){background:var(--lb);transform:translateY(-1px);}
.wb-word.used{opacity:.35;cursor:default;}
.wb-word.selected-wb{background:var(--blue);color:white;}
.wb-sentence{font-size:14px;line-height:2.2;margin-bottom:8px;}
.wb-blank{display:inline-block;min-width:130px;border-bottom:2.5px solid var(--blue);padding:0 8px;text-align:center;font-weight:700;color:var(--blue);cursor:pointer;position:relative;transition:all .15s;}
.wb-blank:hover:not(.has-word){border-bottom-color:var(--navy);}
.wb-blank.has-word{border-bottom-color:var(--green);}
.wb-blank.correct{color:var(--green)!important;border-bottom-color:var(--green)!important;}
.wb-blank.incorrect{color:var(--rose)!important;border-bottom-color:var(--rose)!important;}

/* ── KEY LANGUAGE ── */
.kl-panel{border-radius:12px;padding:16px 20px;margin-bottom:16px;}
.kl-title{font-size:13.5px;font-weight:800;text-transform:uppercase;letter-spacing:.5px;margin-bottom:12px;}
.kl-row{display:flex;align-items:baseline;gap:10px;margin-bottom:8px;font-size:13.5px;line-height:1.6;}
.kl-tag{font-size:10.5px;font-weight:700;border-radius:6px;padding:2px 8px;white-space:nowrap;flex-shrink:0;}
.kl-example{font-size:13px;color:var(--gray);font-style:italic;margin-left:24px;margin-bottom:10px;line-height:1.5;}

/* ── FPICK ── */
.fp-item{margin-bottom:18px;padding:14px;border:1.5px solid var(--border);border-radius:10px;background:#fafafa;}
.fp-q{font-size:14px;font-weight:600;margin-bottom:10px;line-height:1.5;}
.fp-opts{display:flex;gap:8px;flex-wrap:wrap;}
.fp-opt{padding:7px 16px;border:1.5px solid var(--border);border-radius:8px;background:white;font-size:13.5px;cursor:pointer;transition:all .15s;font-family:inherit;font-weight:600;}
.fp-opt:hover:not(.locked){border-color:var(--purple);background:var(--lp);}
.fp-opt.correct{background:#dcfce7!important;border-color:var(--green)!important;color:#14532d!important;}
.fp-opt.wrong{background:#ffe4e6!important;border-color:var(--rose)!important;color:#9f1239!important;}
.fp-opt.locked{cursor:default;}
.fp-hint{display:none;margin-top:10px;padding:9px 13px;background:var(--lp);border:1px solid #c4b5fd;border-radius:8px;font-size:13px;color:#4c1d95;line-height:1.5;}
.fp-hint.show{display:block;}

/* ── SPEAKING SCENES ── */
.scene-nav-bar{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;gap:8px;}
.scene-dot-row{display:flex;gap:5px;}
.scene-dot{width:9px;height:9px;border-radius:50%;background:var(--border);transition:all .2s;cursor:pointer;}
.scene-dot.active{background:var(--amber);transform:scale(1.3);}
.scene-dot.done{background:var(--green);}
.sc-nav-btn{background:var(--amber);color:white;border:none;border-radius:8px;padding:7px 16px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;transition:background .15s;}
.sc-nav-btn:hover{background:#b45309;}
.scene-block{display:none;}
.scene-block.active{display:block;}
.scene-card{border:1.5px solid var(--la);border-radius:12px;padding:18px;background:#fffbeb;margin-bottom:12px;}
.scene-title{font-size:13px;font-weight:700;color:var(--amber);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;}
.scene-prompt{font-size:14.5px;font-weight:600;color:var(--text);line-height:1.5;margin-bottom:10px;}
.scene-hint{font-size:13px;color:var(--gray);font-style:italic;}
.sa-box{display:none;margin-top:12px;padding:12px 15px;background:white;border:1.5px solid var(--amber);border-radius:8px;font-size:13.5px;line-height:1.6;color:var(--text);}
.sa-box.show{display:block;}
.sa-btn{margin-top:10px;background:none;border:1.5px solid var(--amber);color:var(--amber);border-radius:8px;padding:6px 14px;font-size:12.5px;font-weight:700;cursor:pointer;transition:all .15s;font-family:inherit;}
.sa-btn:hover{background:var(--amber);color:white;}

/* ── PREV BOX ── */
.prev-box{background:linear-gradient(135deg,#0d9488 0%,#0f766e 100%);border-radius:12px;padding:16px 20px;margin-top:16px;}
.prev-box-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:rgba(255,255,255,0.7);margin-bottom:10px;}
.prev-box-items{display:flex;flex-direction:column;gap:6px;}
.prev-box-item{font-size:13px;color:white;line-height:1.5;padding:6px 10px;background:rgba(255,255,255,0.12);border-radius:6px;}
.prev-box-item em{font-style:normal;font-weight:700;}

/* ── MATCHING ── */
.match-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.match-col-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:var(--gray);margin-bottom:8px;}
.match-left-item,.match-right-item{display:flex;align-items:center;gap:10px;padding:10px 14px;border:1.5px solid var(--border);border-radius:9px;margin-bottom:8px;cursor:pointer;background:white;transition:all .15s;user-select:none;font-size:13.5px;}
.match-left-item:hover:not(.matched),.match-right-item:hover:not(.matched){border-color:var(--navy);}
.match-left-item.selected,.match-right-item.selected{background:var(--lb);border-color:var(--blue);}
.match-left-item.matched,.match-right-item.matched{cursor:default;}
.match-badge{font-size:11px;font-weight:800;padding:3px 8px;border-radius:6px;flex-shrink:0;}
.match-left-item .match-badge{background:var(--navy);color:white;}
.match-right-item .match-badge{background:var(--lb);color:var(--navy);}
.match-left-item.matched .match-badge,.match-right-item.matched .match-badge{background:var(--green);color:white;}
.match-wrong-flash{animation:wrongFlash .4s;}
@keyframes wrongFlash{0%,100%{transform:translateX(0);}25%{transform:translateX(-4px);}75%{transform:translateX(4px);}}

/* ── BOTTOM NAV ── */
.slide-bottom-nav{display:flex;justify-content:space-between;align-items:center;padding:16px 22px;margin-top:24px;border-top:2px solid var(--border);background:#f8fafc;border-radius:0 0 16px 16px;}

/* ── BUTTONS ── */
.btn{border:none;border-radius:9px;padding:9px 20px;font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;transition:all .15s;}
.btn-primary{background:var(--navy);color:white;}
.btn-primary:hover{background:#263d5c;}
.btn-outline{background:none;border:1.5px solid var(--border);color:var(--gray);}
.btn-outline:hover{border-color:var(--navy);color:var(--navy);}
.btn-sm{padding:6px 14px;font-size:12px;}
.btn-green{background:var(--green);color:white;}
.btn-green:hover{background:#15803d;}
.btn-center{display:flex;justify-content:center;gap:10px;margin-top:16px;}
</style>
</head>
<body>

<div class="top-home-strip"><a class="top-home-link" href="index.html">🏠 Home</a></div>
<button id="pdfBtn" onclick="downloadNotes()" title="Save all your notes as a PDF">📄 PDF Notes</button>
<button id="notesBtn" onclick="toggleNotes()">📝 Notes</button>

<!-- ══ SLIDE NAVBAR ══ -->
<div class="slide-navbar">
  <button class="slide-nav-btn" id="slide-prev" onclick="slideNav(-1)" disabled>← Prev</button>
  <div class="slide-info">
    <div class="slide-label" id="slide-label">Cover</div>
