/* ═══ draggable notes panel ═══ */
window.addEventListener('DOMContentLoaded', function(){
  var panel = document.getElementById('notesPanel');
  var handle = document.getElementById('notesDragHandle');
  if(!panel || !handle) return;
  var POS_KEY = NOTES_KEY + ':pos';
  var dragging = false, offsetX = 0, offsetY = 0;
  function getZoomFactor(){
    var z = parseFloat(getComputedStyle(document.body).zoom);
    return (z && !isNaN(z)) ? z : 1;
  }
  function clampAndApply(x, y){
    var Z = getZoomFactor();
    var maxX = (window.innerWidth / Z) - panel.offsetWidth - 8;
    var maxY = (window.innerHeight / Z) - panel.offsetHeight - 8;
    x = Math.max(8, Math.min(x, Math.max(8, maxX)));
    y = Math.max(8, Math.min(y, Math.max(8, maxY)));
    panel.style.left = x + 'px';
    panel.style.top = y + 'px';
    panel.style.right = 'auto';
    panel.style.bottom = 'auto';
  }
  function onDown(e){
    dragging = true;
    var Z = getZoomFactor();
    var rect = panel.getBoundingClientRect();
    var pt = e.touches ? e.touches[0] : e;
    offsetX = (pt.clientX / Z) - (rect.left / Z);
    offsetY = (pt.clientY / Z) - (rect.top / Z);
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
    document.addEventListener('touchmove', onMove, {passive:false});
    document.addEventListener('touchend', onUp);
    e.preventDefault();
  }
  function onMove(e){
    if(!dragging) return;
    var Z = getZoomFactor();
    var pt = e.touches ? e.touches[0] : e;
    clampAndApply((pt.clientX / Z) - offsetX, (pt.clientY / Z) - offsetY);
    if(e.touches) e.preventDefault();
  }
  function onUp(){
    if(!dragging) return;
    dragging = false;
    document.removeEventListener('mousemove', onMove);
    document.removeEventListener('mouseup', onUp);
    document.removeEventListener('touchmove', onMove);
    document.removeEventListener('touchend', onUp);
    try{
      var Z = getZoomFactor();
      var rect = panel.getBoundingClientRect();
      localStorage.setItem(POS_KEY, JSON.stringify({left:rect.left/Z, top:rect.top/Z}));
    }catch(err){}
  }
  handle.addEventListener('mousedown', onDown);
  handle.addEventListener('touchstart', onDown, {passive:false});
  window.addEventListener('resize', function(){
    if(panel.classList.contains('open') && panel.style.left){
      var Z = getZoomFactor();
      var r=panel.getBoundingClientRect();
      clampAndApply(r.left/Z, r.top/Z);
    }
  });
  window.__notesPosRestore = function(){
    try{
      var saved = JSON.parse(localStorage.getItem(POS_KEY) || 'null');
      if(saved) clampAndApply(saved.left, saved.top);
    }catch(err){}
  };
});
