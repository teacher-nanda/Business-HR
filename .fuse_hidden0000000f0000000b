<script>
const SLIDE_LABELS = ["Cover","Part 1 · Warm-up","Part 2 · Reading","Part 3 · Vocabulary","Part 4 · Grammar","Part 5 · Speaking","Wrap-up","Extra Activity","Homework"];
const TOTAL_SLIDES = 9;
let currentSlide = 0;

/* ── NAVIGATION ── */
function slideNav(dir) {
  const n = currentSlide + dir;
  if (n < 0 || n >= TOTAL_SLIDES) return;
  goToSlide(n);
}
function goToSlide(n) {
  saveCurrentNotes();
  document.getElementById('slide-' + currentSlide).classList.remove('active');
  currentSlide = n;
  document.getElementById('slide-' + currentSlide).classList.add('active');
  updateSlideUI();
  loadNotes(n);
  window.scrollTo({ top: 0, behavior: 'instant' });
}
function updateSlideUI() {
  const prev = document.getElementById('slide-prev');
  const next = document.getElementById('slide-next');
  if (prev) prev.disabled = currentSlide === 0;
  if (next) {
    if (currentSlide === TOTAL_SLIDES - 1) {
      next.disabled = false; next.textContent = '🏠 Course Home';
      next.onclick = () => { window.location.href='index.html'; };
    } else {
      next.disabled = false; next.textContent = 'Next →';
      next.onclick = () => slideNav(1);
    }
  }
  const lbl = document.getElementById('slide-label');
  if (lbl) lbl.textContent = SLIDE_LABELS[currentSlide];
  const ctr = document.getElementById('slide-counter');
  if (ctr) ctr.textContent = 'Slide ' + (currentSlide+1) + ' of ' + TOTAL_SLIDES;
  document.querySelectorAll('.sp-dot').forEach((d, i) => {
    d.classList.remove('active','done');
    if (i < currentSlide) d.classList.add('done');
    else if (i === currentSlide) d.classList.add('active');
  });
}

/* ── TFD ── */
function tfdPick(btn, correct, expId) {
  const item = btn.closest('.tfd-item');
  const btns = item.querySelectorAll('.tfd-btn');
  if ([...btns].some(b => b.classList.contains('sel-t') || b.classList.contains('sel-f') || b.classList.contains('sel-d'))) return;
  btns.forEach(b => b.classList.add('locked'));
  const labels = ['T','F','D'];
  const classes = ['sel-t','sel-f','sel-d'];
  const idx = [...btns].indexOf(btn);
  btn.classList.add(classes[idx]);
  document.getElementById(expId).classList.add('show');
}

/* ── MC PICK ── */
function mcPick(el, correct) {
  const opts = el.closest('.mc-opts').querySelectorAll('.mc-opt');
  if ([...opts].some(o => o.classList.contains('correct') || o.classList.contains('wrong'))) return;
  opts.forEach(o => o.classList.add('locked'));
  if (correct) { el.classList.add('correct'); }
  else {
    el.classList.add('wrong');
    opts.forEach(o => { if (o.onclick && o.onclick.toString().includes('true')) o.classList.add('correct'); });
  }
}

/* ── WORD BANK ── */
let wbSelected = null, wbSelectedEl = null;
function selectWb(el, word) {
  if (el.classList.contains('used')) return;
  if (wbSelectedEl) wbSelectedEl.classList.remove('selected-wb');
  if (wbSelectedEl === el) { wbSelected=null; wbSelectedEl=null; return; }
  wbSelected = word; wbSelectedEl = el;
  el.classList.add('selected-wb');
}
function dropOnBlank(blank) {
  if (blank.classList.contains('has-word')) {
    const old = blank.dataset.filled;
    blank.textContent = ''; blank.dataset.filled = '';
    blank.classList.remove('has-word','correct','incorrect');
    blank.style.borderBottomColor = '';
    document.querySelectorAll('.wb-word').forEach(w => {
      if (w.textContent === old) { w.classList.remove('used'); }
    });
  }
  if (wbSelected) {
    blank.textContent = wbSelected; blank.dataset.filled = wbSelected;
    blank.classList.add('has-word');
    if (wbSelectedEl) { wbSelectedEl.classList.remove('selected-wb'); wbSelectedEl.classList.add('used'); }
    wbSelected = null; wbSelectedEl = null;
  }
}
function checkBlanks(ids, bankId) {
  ids.forEach(id => {
    const blank = document.getElementById(id);
    if (!blank.classList.contains('has-word')) return;
    const ans = (blank.dataset.answer || '').toLowerCase().trim();
    const filled = (blank.dataset.filled || '').toLowerCase().trim();
    if (filled === ans) { blank.classList.add('correct'); blank.classList.remove('incorrect'); }
    else { blank.classList.add('incorrect'); blank.classList.remove('correct'); }
  });
}
function resetBlanks(ids, bankId) {
  ids.forEach(id => {
    const blank = document.getElementById(id);
    blank.textContent = ''; blank.dataset.filled = '';
    blank.classList.remove('has-word','correct','incorrect');
    blank.style.borderBottomColor = '';
  });
  document.querySelectorAll('#'+bankId+' .wb-word').forEach(w => w.classList.remove('used','selected-wb'));
  wbSelected = null; wbSelectedEl = null;
}

/* ── FPICK ── */
function fpPick(el, correct, hintId) {
  const opts = el.closest('.fp-opts').querySelectorAll('.fp-opt');
  if ([...opts].some(o => o.classList.contains('correct') || o.classList.contains('wrong'))) return;
  opts.forEach(o => o.classList.add('locked'));
  if (correct) { el.classList.add('correct'); }
  else {
    el.classList.add('wrong');
    opts.forEach(o => { if (o.onclick && o.onclick.toString().includes('true')) o.classList.add('correct'); });
  }
  document.getElementById(hintId).classList.add('show');
}

